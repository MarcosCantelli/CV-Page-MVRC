# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Runtime variables are read by the server; build-time ones are baked into the
# static HTML when the image is built (they are public by nature).
# ---------------------------------------------------------------------------

# ===== Runtime (server) =====

# Mail driver: "resend" (sends e-mail) or "log" (prints to the console, for dev).
MAIL_DRIVER=log

# Resend API key with "Sending access" only (https://resend.com/api-keys).
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
CONTACT_FROM_EMAIL="Site mvrc.com.br <contato@mvrc.com.br>"
# Where contact form messages are delivered.
CONTACT_TO_EMAIL=

# Cloudflare Turnstile secret key. Development test secret (always passes):
#   1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Port the Node server listens on (inside the container).
PORT=4321
# Send Strict-Transport-Security. Set to false when served over plain HTTP (LAN).
HSTS=true

# ===== docker compose only =====

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Production only.
TUNNEL_TOKEN=
# Image tag to run (latest | dev | sha-<commit>).
# TAG=latest

# ===== Build time (public, used by `pnpm build` / docker build args) =====

# Public site URL and base path.
# SITE_URL=https://mvrc.com.br
# BASE_PATH=/
# Turnstile site key. Development test key (always passes): 1x00000000000000000000AA
# PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
