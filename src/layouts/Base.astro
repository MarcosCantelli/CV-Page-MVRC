---
import '../styles/global.css';
import type { Locale } from '../content/types';
import IconSprite from '../components/IconSprite.astro';
import { asset, getContent, htmlLang, locales, localeHome, ogLocale } from '../lib/i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { locale, noindex = false } = Astro.props;
const { cv, t } = getContent(locale);
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;

const site = Astro.site ?? new URL('https://mvrc.com.br');
const canonical = new URL(localeHome(locale), site).href;
const ogImage = new URL(asset(`og-${locale}.png`), site).href;
const alternates = locales.map((l) => ({
  hreflang: htmlLang[l],
  href: new URL(localeHome(l), site).href,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: cv.name,
  jobTitle: cv.headline.split('|')[0]?.trim(),
  url: canonical,
  image: ogImage,
  sameAs: [cv.links.github, cv.links.linkedin],
  worksFor: { '@type': 'Organization', name: 'Bradesco' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'FIAP' },
  knowsAbout: cv.skills.flatMap((g) => g.items.filter((i) => i.icon).map((i) => i.label)),
  knowsLanguage: ['pt-BR', 'en'],
};
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(localeHome('pt'), site).href} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f6f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Marcos Cantelli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${cv.name} · ${cv.headline}`} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {locales
      .filter((l) => l !== locale)
      .map((l) => (
        <meta property="og:locale:alternate" content={ogLocale[l]} />
      ))}
    <meta property="profile:first_name" content="Marcos" />
    <meta property="profile:last_name" content="Cantelli" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Applies the saved/system theme before first paint (no flash). -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        let t = null;
        try {
          t = localStorage.getItem('theme');
        } catch {
          /* storage blocked */
        }
        if (t !== 'light' && t !== 'dark')
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
      })();
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-dvh">
    <IconSprite />
    <slot />
  </body>
</html>
