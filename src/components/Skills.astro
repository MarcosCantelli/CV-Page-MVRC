---
import type { Locale } from '../content/types';
import { getContent } from '../lib/i18n';
import Icon from './Icon.astro';
import Section from './Section.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { cv, t } = getContent(locale);
---

<Section id="skills" title={t.sections.skills}>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {cv.skills.map((group) => (
      <section
        class="reveal rounded-xl border border-border bg-surface p-5"
        aria-label={group.title}
      >
        <h3 class="mb-4 font-semibold">{group.title}</h3>
        <ul class="flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="inline-flex items-center gap-1.5 rounded-md bg-surface-2 px-2.5 py-1 text-sm">
              {item.icon && <Icon name={item.icon} class="size-4 text-muted" />}
              {item.label}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Section>
