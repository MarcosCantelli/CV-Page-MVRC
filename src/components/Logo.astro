---
// MVRC wordmark (vector re-drawing of Marcos' logo). "MVR" follows the text color, the arrow on
// the V uses the accent color and the "C" is muted, so it adapts to light and dark themes.
interface Props {
  class?: string;
}
const { class: className = 'h-6 w-auto' } = Astro.props;
---

<svg
  viewBox="0 0 113 30"
  class={className}
  role="img"
  aria-label="MVRC"
  fill="none"
  stroke-width="4.5"
  stroke-linejoin="miter"
>
  <g stroke="currentColor">
    <path d="M3.5 27V4l11 13.5L25.5 4v23" />
    <path d="M31 4l11 23 7-14.5" />
    <path d="M62 27V4h10a7.25 7.25 0 0 1 0 14.5H62m8.5 0L80 27" />
  </g>
  <!-- rising arrow on the V -->
  <path d="M49 12.5l5.5-11" stroke="var(--accent)" />
  <path d="M50.5 1.5h7v7z" fill="var(--accent)" stroke="var(--accent)" stroke-width="1" />
  <path d="M107 8A11.5 11.5 0 1 0 107 23" stroke="var(--muted)" />
</svg>
