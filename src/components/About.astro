---
import type { Locale } from '../content/types';
import { getContent } from '../lib/i18n';
import Icon from './Icon.astro';
import Section from './Section.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { cv, t } = getContent(locale);
---

<Section id="about" title={t.sections.about}>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-12">
    <p class="reveal text-lg leading-relaxed text-pretty">{cv.about}</p>
    <div class="reveal self-start rounded-xl border border-border bg-surface p-5">
      <h3 class="mb-3 text-sm font-semibold tracking-wide text-muted uppercase">
        {t.sections.education}
      </h3>
      <ul class="space-y-2">
        {cv.education.map((e) => (
          <li class="flex items-center gap-3">
            <Icon name="school" class="size-5 text-accent" />
            <span>
              <span class="font-medium">{e.degree}</span>
              <span class="text-muted"> · {e.school}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>
