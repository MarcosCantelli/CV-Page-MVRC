---
import { Picture } from 'astro:assets';
import type { Locale } from '../content/types';
import { getContent } from '../lib/i18n';
import { getLogo, initials } from '../lib/images';
import Section from './Section.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { cv, t } = getContent(locale);
---

<Section id="experience" title={t.sections.experience}>
  <div class="relative">
    <span
      class="timeline-line absolute top-2 bottom-2 left-6 w-px bg-accent/40 sm:left-7"
      aria-hidden="true"
    ></span>
    <ol class="space-y-12">
      {cv.experience.map((job) => {
        const logo = getLogo(job.logo);
        return (
          <li class="reveal relative grid grid-cols-[3rem_1fr] gap-4 sm:grid-cols-[3.5rem_1fr] sm:gap-6">
            <div class="relative z-10 grid size-12 place-items-center overflow-hidden rounded-full border border-border bg-surface shadow-sm sm:size-14">
              {logo ? (
                <Picture
                  src={logo}
                  alt={job.company}
                  formats={['avif', 'webp']}
                  width={112}
                  class="size-full object-contain p-2"
                />
              ) : (
                <span class="text-sm font-semibold text-accent" role="img" aria-label={job.company}>
                  {initials(job.company)}
                </span>
              )}
            </div>
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-xl font-semibold">
                  {job.company}
                  {job.unit && <span class="font-normal text-muted"> · {job.unit}</span>}
                </h3>
                <p class="text-sm text-muted tabular-nums">{job.period}</p>
              </div>
              <ol class="mt-4 space-y-6">
                {job.roles.map((role) => (
                  <li class="rounded-xl border border-border bg-surface p-5">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                      <h4 class="font-semibold">
                        {role.title}
                        {role.detail && (
                          <span class="block text-sm font-normal text-muted sm:inline">
                            <span class="hidden sm:inline"> · </span>
                            {role.detail}
                          </span>
                        )}
                      </h4>
                      <p class="text-sm whitespace-nowrap text-accent tabular-nums">
                        {role.period}
                      </p>
                    </div>
                    <ul class="mt-3 list-disc space-y-1.5 pl-5 text-[0.95rem] leading-relaxed marker:text-accent">
                      {role.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ol>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</Section>
