---
import type { Locale } from '../content/types';
import { getContent } from '../lib/i18n';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { cv, t } = getContent(locale);
---

<Section id="projects" title={t.sections.projects}>
  <h3 class="reveal mb-4 text-sm font-semibold tracking-wide text-muted uppercase">
    {t.sections.technicalProjects}
  </h3>
  <ul class="grid gap-5 sm:grid-cols-2">
    {cv.projects.map((p) => (
      <li class="reveal">
        <article class="lift flex h-full flex-col rounded-xl border border-border bg-surface p-5 shadow-sm hover:border-accent hover:shadow-md">
          <div class="flex items-start justify-between gap-3">
            <h4 class="text-lg font-semibold">{p.title}</h4>
            <div class="flex gap-1.5 text-muted">
              {p.tags.map((tag) => (
                <Icon name={tag} class="size-4.5" />
              ))}
            </div>
          </div>
          <p class="mt-2 text-muted">{p.description}</p>
          {p.url && (
            <ExternalLink
              href={p.url}
              locale={locale}
              class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-medium text-accent hover:underline"
            >
              <Icon name="github" class="size-4" />
              {t.projects.viewGithub}
            </ExternalLink>
          )}
        </article>
      </li>
    ))}
  </ul>
  <p class="reveal mt-5 text-sm text-muted">
    <ExternalLink
      href={cv.projectsNote.url}
      locale={locale}
      class="hover:text-accent hover:underline"
    >
      {cv.projectsNote.text}
    </ExternalLink>
  </p>

  <h3 class="reveal mt-12 mb-4 text-sm font-semibold tracking-wide text-muted uppercase">
    {t.sections.academicProjects}
  </h3>
  <ol class="grid gap-3 lg:grid-cols-2">
    {cv.academicProjects.map((p) => (
      <li class="reveal grid grid-cols-[3.5rem_1fr] gap-4 rounded-xl border border-border bg-surface p-4">
        <span class="font-semibold text-accent tabular-nums">{p.year}</span>
        <div>
          <h4 class="font-semibold">
            {p.title}
            {p.note && <span class="font-normal text-muted"> ({p.note})</span>}
          </h4>
          <p class="text-muted">{p.description}</p>
        </div>
      </li>
    ))}
  </ol>
</Section>
