---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import type { Locale } from '../content/types';
import { HONEYPOT_FIELD } from '../lib/contact-schema';
import { asset, getContent } from '../lib/i18n';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { cv, t } = getContent(locale);

const input =
  'mt-1.5 block w-full rounded-lg border border-border bg-surface px-3.5 py-2.5 text-fg placeholder:text-muted/70 focus:border-accent focus:outline-none focus-visible:outline-2 focus-visible:outline-accent aria-[invalid=true]:border-red-600 dark:aria-[invalid=true]:border-red-400';
const label = 'block text-sm font-medium';
const error = 'mt-1 hidden text-sm text-red-700 dark:text-red-300';

const fields = [
  { name: 'name', label: t.contact.name, type: 'text', autocomplete: 'name', required: true },
  { name: 'email', label: t.contact.email, type: 'email', autocomplete: 'email', required: true },
  {
    name: 'company',
    label: t.contact.company,
    type: 'text',
    autocomplete: 'organization',
    required: false,
  },
] as const;
---

<Section id="contact" title={t.sections.contact}>
  <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div class="reveal">
      <p class="text-lg text-pretty">{t.contact.intro}</p>
      <p class="mt-6 text-sm text-muted">{t.contact.elsewhere}</p>
      <ul class="mt-3 flex flex-col gap-2">
        <li>
          <ExternalLink
            href={cv.links.linkedin}
            locale={locale}
            class="inline-flex items-center gap-2 font-medium hover:text-accent"
          >
            <Icon name="linkedin" class="size-5" /> LinkedIn
          </ExternalLink>
        </li>
        <li>
          <ExternalLink
            href={cv.links.github}
            locale={locale}
            class="inline-flex items-center gap-2 font-medium hover:text-accent"
          >
            <Icon name="github" class="size-5" /> GitHub
          </ExternalLink>
        </li>
      </ul>
    </div>

    <form
      id="contact-form"
      class="reveal space-y-5 rounded-xl border border-border bg-surface p-5 shadow-sm sm:p-7"
      novalidate
      data-endpoint={asset('api/contact')}
      data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}
      data-lang={locale}
      data-messages={JSON.stringify({ ...t.contact.errors, success: t.contact.success })}
      data-sending={t.contact.sending}
    >
      <div class="grid gap-5 sm:grid-cols-2">
        {fields.map((f) => (
          <div class={f.name === 'company' ? 'sm:col-span-2' : ''}>
            <label for={`cf-${f.name}`} class={label}>
              {f.label}
              {!f.required && <span class="font-normal text-muted"> ({t.contact.optional})</span>}
            </label>
            <input
              id={`cf-${f.name}`}
              name={f.name}
              type={f.type}
              autocomplete={f.autocomplete}
              required={f.required}
              maxlength={f.name === 'email' ? 254 : f.name === 'company' ? 120 : 100}
              aria-describedby={`cf-${f.name}-error`}
              class={input}
            />
            <p id={`cf-${f.name}-error`} class={error} data-error-for={f.name}>
              {t.contact.errors[f.name]}
            </p>
          </div>
        ))}
      </div>

      <div>
        <label for="cf-message" class={label}>
          {t.contact.message}
        </label>
        <textarea
          id="cf-message"
          name="message"
          rows="6"
          required
          maxlength="5000"
          aria-describedby="cf-message-error"
          class={input}
        ></textarea>
        <p id="cf-message-error" class={error} data-error-for="message">
          {t.contact.errors.message}
        </p>
      </div>

      <!-- Honeypot: hidden from people and assistive tech; bots tend to fill it. -->
      <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
        <label for={`cf-${HONEYPOT_FIELD}`}>Website</label>
        <input
          id={`cf-${HONEYPOT_FIELD}`}
          name={HONEYPOT_FIELD}
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div data-turnstile class="min-h-[65px]"></div>

      <div class="flex flex-wrap items-center gap-4">
        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-2.5 font-medium text-accent-fg shadow-sm transition-opacity hover:opacity-90 disabled:cursor-wait disabled:opacity-60"
        >
          <Icon name="mail" class="size-4.5" />
          <span data-submit-label>{t.contact.submit}</span>
        </button>
        <p data-status role="status" aria-live="polite" class="text-sm"></p>
      </div>
    </form>
  </div>
</Section>

<script>
  import { initContactForm } from '../scripts/contact';
  initContactForm();
</script>
