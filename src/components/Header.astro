---
import type { Locale } from '../content/types';
import { getContent, localeHome } from '../lib/i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = getContent(locale);
const other: Locale = locale === 'pt' ? 'en' : 'pt';
const home = localeHome(locale);

const links = [
  ['about', t.nav.about],
  ['experience', t.nav.experience],
  ['certifications', t.nav.certifications],
  ['skills', t.nav.skills],
  ['projects', t.nav.projects],
  ['courses', t.nav.courses],
  ['contact', t.nav.contact],
] as const;
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/70">
  <a
    href="#main"
    class="sr-only z-50 rounded bg-accent px-3 py-2 text-accent-fg focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
  >
    {t.skipLink}
  </a>
  <div class="mx-auto flex h-16 max-w-5xl items-center gap-3 px-4 sm:px-6">
    <a
      href={home}
      class="mr-auto flex items-center gap-2 font-semibold tracking-tight"
      aria-label="Marcos Cantelli"
    >
      <span
        class="grid size-8 place-items-center rounded-md bg-accent text-sm font-bold text-accent-fg"
        aria-hidden="true"
      >
        MC
      </span>
      <span class="hidden sm:inline">Marcos Cantelli</span>
    </a>

    <nav aria-label={t.nav.label} class="hidden lg:block">
      <ul class="flex items-center gap-1 text-sm">
        {links.map(([id, label]) => (
          <li>
            <a
              href={`#${id}`}
              data-nav={id}
              class="rounded-md px-2.5 py-1.5 text-muted transition-colors hover:text-fg aria-[current=true]:text-accent"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href={localeHome(other)}
      hreflang={other === 'pt' ? 'pt-BR' : 'en-US'}
      lang={other === 'pt' ? 'pt-BR' : 'en-US'}
      data-lang-switch
      class="inline-flex h-9 items-center gap-1.5 rounded-md border border-border px-2.5 text-sm font-medium hover:border-accent hover:text-accent"
      aria-label={t.lang.switchLabel}
    >
      <Icon name="globe" class="size-4" />
      {t.lang.short}
    </a>

    <button
      type="button"
      data-theme-toggle
      class="grid size-9 place-items-center rounded-md border border-border hover:border-accent hover:text-accent"
      aria-label={t.theme.toggle}
      title={t.theme.toggle}
    >
      <Icon name="moon" class="size-4.5 dark:hidden" />
      <Icon name="sun" class="hidden size-4.5 dark:block" />
    </button>

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="grid size-9 place-items-center rounded-md border border-border hover:border-accent lg:hidden"
      data-label-open={t.nav.menu}
      data-label-close={t.nav.close}
      aria-label={t.nav.menu}
    >
      <Icon name="menu" class="size-4.5" />
    </button>
  </div>

  <nav id="mobile-nav" aria-label={t.nav.label} class="hidden border-t border-border lg:hidden">
    <ul class="mx-auto grid max-w-5xl gap-1 px-4 py-3 sm:px-6">
      {links.map(([id, label]) => (
        <li>
          <a
            href={`#${id}`}
            data-nav={id}
            class="block rounded-md px-3 py-2 hover:bg-surface-2 aria-[current=true]:text-accent"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
