---
import type { Locale } from '../content/types';
import { getContent } from '../lib/i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { t } = getContent(Astro.props.locale);
---

<!-- Name stays constant; aria-pressed (kept in sync by scripts/theme.ts) says whether dark is on. -->
<button
  type="button"
  data-theme-toggle
  aria-pressed="false"
  class="grid size-9 place-items-center rounded-md border border-border-strong hover:border-accent hover:text-accent"
  aria-label={t.theme.dark}
  title={t.theme.dark}
>
  <Icon name="moon" class="size-4.5 dark:hidden" />
  <Icon name="sun" class="hidden size-4.5 dark:block" />
</button>
